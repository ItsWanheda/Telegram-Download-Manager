# ============================================================
# TELEGRAM
# ============================================================

TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=


# ============================================================
# STORAGE
# ============================================================

DOWNLOAD_DIR=downloads
DB_PATH=jobs.db

LOG_FILE=logs/app.log


# ============================================================
# DOWNLOAD CONCURRENCY
# ============================================================

# Maximum number of complete downloads running simultaneously.
MAX_DOWNLOAD_WORKERS=3

# Maximum number of HTTP range parts downloaded simultaneously
# for a single file.
PART_WORKERS=4

# Maximum simultaneous Telegram uploads.
UPLOAD_WORKERS=2


# ============================================================
# DOWNLOAD PERFORMANCE
# ============================================================

# Multipart size.
# Default = 8 MiB.
PART_SIZE=8388608

# Streaming chunk size.
# Default = 1 MiB.
CHUNK_SIZE=1048576


# ============================================================
# RETRIES / TIMEOUTS
# ============================================================

MAX_RETRIES=5

REQUEST_TIMEOUT=3600

UPLOAD_TIMEOUT=3600


# ============================================================
# DOWNLOAD BEHAVIOUR
# ============================================================

# Continue partially downloaded files.
RESUME_DOWNLOADS=true

# Calculate SHA-256 after download.
VERIFY_CHECKSUM=true

# Delete local file after successful Telegram upload.
DELETE_AFTER_UPLOAD=true

# Delete temporary multipart files after a failed job.
CLEANUP_FAILED_PARTS=false

# Recover jobs left in downloading/uploading state
# after an application crash.
RECOVER_STALE_JOBS=true


# ============================================================
# SECURITY
# ============================================================

# Allow downloading from private/local IP addresses.
#
# Keep this false unless you intentionally need internal
# network downloads.
ALLOW_PRIVATE_HOSTS=false


# ============================================================
# DISK LIMITS
# ============================================================

# Minimum free space to preserve on the download disk.
# 512 MiB by default.
MIN_FREE_DISK_SPACE=536870912

# Maximum allowed remote file size.
#
# 0 = unlimited.
MAX_FILE_SIZE=0


# ============================================================
# LOGGING
# ============================================================

LOG_LEVEL=INFO